# Database URL (PostgreSQL)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Resend API Key
# Obtenha sua chave em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Admin Password (para acessar preview de emails)
# Use uma senha forte e única
ADMIN_PASSWORD=sua_senha_segura

# JWT Secret (para autenticação)
# Gere um secret seguro com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere-um-secret-com-o-comando-acima

# Porta do servidor (opcional)
PORT=3001

# Ambiente
NODE_ENV=development
